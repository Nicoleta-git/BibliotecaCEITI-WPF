<Application x:Class="BibliotecaCEITI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BibliotecaCEITI"
             StartupUri="Views/Loading.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default theme loaded at startup -->
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>

                <!-- Global shared styles and control templates -->
                <ResourceDictionary Source="Themes/DefaultControls.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>

                <!-- Default language: English -->
                <ResourceDictionary Source="Languages/Strings.en.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>